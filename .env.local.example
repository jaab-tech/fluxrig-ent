# Copy to .env.local, which git ignores. It is Makefile syntax.
#
# Only needed when the open-source repository is not checked out at ../fluxrig.
# The replace directive in go.mod names the same path: change both together.
#FLUXRIG_DIR = /path/to/fluxrig

# Where `make gear-docs` writes the sim_source/sim_responder reference pages.
# Same value as the engine's own .env.local: both target fluxrig.org/docs/reference/gears.
#GEAR_DOCS_DIR = /path/to/fluxrig.org/docs/reference/gears
